# Copy the settings below into your environment; the scripts read the process
# environment directly (there is no .env loader). On Windows, persist with:
#   setx CDKEYS_DB "C:\path\to\cd_keys_encrypted.sqlite3"
# Either script also accepts --db PATH, which takes precedence.

# Path to the SQLCipher-encrypted licence database.
CDKEYS_DB=C:\path\to\cd_keys_encrypted.sqlite3
